#!/bin/bash
#
# pgenerator-update — PGenerator+ OTA update via GitHub Releases
#
# Usage:
#   pgenerator-update check          — check for new version, print JSON
#   pgenerator-update apply          — download and apply latest release
#   pgenerator-update version        — print current version
#
# Update stream: https://github.com/oldgithubman/PGenerator-Plus/releases
# (factory default; override via ota_repo in /etc/PGenerator/PGenerator.conf
#  or the GITHUB_REPO environment variable). A non-default ota_repo only
# passes `apply` when ota_repo_trusted=1 is also set — see the trust gate
# in the apply branch.
#
# Release assets are tar.gz archives containing files in FHS layout:
#   usr/share/PGenerator/*.pm
#   usr/sbin/pgenerator-*
#   usr/bin/*
#   etc/PGenerator/*
#   etc/udev/rules.d/*
#
# The archive is extracted over / so paths must match the installed layout.
# Each release carries one payload per build target; the asset name records
# the target (pi4-biasi ships unsuffixed -- legacy name predates multi-
# target releases; pi5-bookworm-armhf carries a "-pi5" tag). The device
# detects its own target and refuses a payload built for another board.
#
# OTA family gate (see ota_gate_reason):
#   Same MAJOR.MINOR family always applies. Stepping to the NEXT minor
#   (2.13.x -> 2.14.0) applies only when the release notes carry a line
#   reading exactly "OTA-Family: cross" within the first 2000 characters.
#   Skipping a minor, or crossing MAJOR, is never OTA: re-flash.
#

set -euo pipefail

DEFAULT_GITHUB_REPO="oldgithubman/PGenerator-Plus"
# Repos trusted out of the box for `apply` even without ota_repo_trusted=1:
# the factory default plus upstream BigShoots (the original project home).
# Keep in sync with $ota_repo_trusted_allowlist in webui.pm. Any other
# repo still needs the explicit operator trust key.
TRUSTED_REPO_ALLOWLIST="$DEFAULT_GITHUB_REPO BigShoots/PGenerator-Plus"
PGENERATOR_CONF_FILE="${PGENERATOR_CONF_FILE:-/etc/PGenerator/PGenerator.conf}"
VERSION_FILE="${VERSION_FILE:-/usr/share/PGenerator/version.pm}"
UPDATE_MIGRATIONS_DIR="${UPDATE_MIGRATIONS_DIR:-/usr/share/PGenerator/update-migrations.d}"
EXEC_MANIFEST_FILE="${EXEC_MANIFEST_FILE:-/usr/share/PGenerator/release-exec-manifest.txt}"
UPDATE_DIR="${UPDATE_DIR:-/var/lib/PGenerator/updates}"
UPDATE_LOG="${UPDATE_LOG:-/var/log/PGenerator/update.log}"
CURL_OPTS="-s -L --connect-timeout 10 --max-time 60"
GITHUB_ACCEPT="Accept: application/vnd.github.v3+json"
GITHUB_UA="User-Agent: PGenerator-Plus-Updater"

# ── Resolve the update repo ──
# The operator can point this device at a different GitHub repo for OTA
# updates and release notifications via the WebUI (System Settings →
# Software Update), which persists ota_repo=owner/name in
# /etc/PGenerator/PGenerator.conf. Precedence: explicit GITHUB_REPO env >
# conf key > factory default. A full URL is accepted and normalized to
# owner/repo. Values that are not a safe owner/repo pair fall back to the
# default so a typo cannot brick the update path or inject a URL.
read_conf_val() {
 [ -f "$PGENERATOR_CONF_FILE" ] || return 0
 # || true: with pipefail set, a missing key makes grep exit 1 and would
 # abort the whole script from inside the $(...) in GITHUB_REPO_RAW.
 grep "^$1=" "$PGENERATOR_CONF_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true
}

# A custom update source is a full root-trust decision (apply extracts an
# unsigned tarball at / as root), so apply accepts only repos in the
# factory TRUSTED_REPO_ALLOWLIST, or any repo whose operator confirmed the
# trust prompt (the WebUI then sets ota_repo_trusted=1 alongside
# ota_repo). A request that rewrites only ota_repo (e.g. a cross-site
# drive-by) can never install code. Manual conf edits must set both keys.
repo_in_allowlist() {
 local allowed
 for allowed in $TRUSTED_REPO_ALLOWLIST; do
  [ "$1" = "$allowed" ] && return 0
 done
 return 1
}

custom_repo_trusted() {
 repo_in_allowlist "$1" || [ "$(read_conf_val ota_repo_trusted)" = "1" ]
}

normalize_repo() {
 # Byte-for-byte parity with webui_ota_repo_normalize() in webui.pm: trim
 # whitespace; prefix strips (/releases suffix, trailing slashes, .git) in
 # the same order; case-insensitive; quoted values are NOT stripped (they
 # fail validation on both sides). The two normalizers disagreeing would
 # let the UI show "Official updates" while the updater pulls from a fork
 # (PR-20 review finding #2). Detection runs against a lowercased copy so
 # every strip is case-insensitive without relying on nocasematch, which
 # does not apply to ${var#pattern} expansions.
 local raw="${1:-}"
 raw="${raw#"${raw%%[![:space:]]*}"}"
 raw="${raw%"${raw##*[![:space:]]}"}"
 local lc
 lc=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')
 # Strip order mirrors webui.pm exactly: github prefix, /releases[(/latest)]
 # with optional trailing slash, trailing slashes, then .git.
 if [[ "$lc" == https://github.com/* ]]; then raw="${raw:19}"; lc="${lc:19}"
 elif [[ "$lc" == http://github.com/* ]]; then raw="${raw:18}"; lc="${lc:18}"
 elif [[ "$lc" == git@github.com:* ]]; then raw="${raw:15}"; lc="${lc:15}"
 fi
 # /releases(/latest)?/?$ — longest alternative first, like the Perl regex
 if [[ "$lc" == */releases/latest ]]; then raw="${raw:0:${#lc}-16}"
 elif [[ "$lc" == */releases/ ]]; then raw="${raw:0:${#lc}-10}"
 elif [[ "$lc" == */releases ]]; then raw="${raw:0:${#lc}-9}"
 fi
 lc=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')
 while [[ "$lc" == */ ]]; do raw="${raw:0:${#raw}-1}"; lc="${lc:0:${#lc}-1}"; done
 [[ "$lc" == *.git ]] && raw="${raw:0:${#raw}-4}"
 printf '%s' "$raw"
}

GITHUB_REPO_RAW="${GITHUB_REPO:-$(read_conf_val ota_repo)}"
GITHUB_REPO="$(normalize_repo "$GITHUB_REPO_RAW")"
if [[ ! "$GITHUB_REPO" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] \
   || [[ "${GITHUB_REPO%/*}" =~ ^[.]+$ ]] || [[ "${GITHUB_REPO#*/}" =~ ^[.]+$ ]]; then
 # Second clause: dot-only segments ('..', '.') pass the charset check
 # but URL-join against api.github.com; refuse them outright.
 GITHUB_REPO="$DEFAULT_GITHUB_REPO"
fi
GITHUB_API="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"

# ── Read current version from version.pm ──
get_current_version() {
 grep '^\$version=' "$VERSION_FILE" 2>/dev/null | sed 's/.*="\([^"]*\)".*/\1/'
}

# ── Log with timestamp ──
log_msg() {
 local ts
 ts=$(date '+%Y-%m-%d %H:%M:%S')
 mkdir -p "$(dirname "$UPDATE_LOG")" 2>/dev/null || true
 echo "[$ts] $*" >> "$UPDATE_LOG" 2>/dev/null || true
 echo "$*"
}

mount_options_for_path() {
 local path="${1:-/}"
 if command -v findmnt >/dev/null 2>&1; then
  findmnt -no OPTIONS -T "$path" 2>/dev/null || true
  return 0
 fi
 awk -v target="$path" '$2 == target {print $4; exit}' /proc/mounts 2>/dev/null || true
}

path_is_read_only() {
 local opts
 opts="$(mount_options_for_path "${1:-/}")"
 printf '%s' "$opts" | tr ',' '\n' | grep -qx 'ro'
}

require_writable_path() {
 local path="$1"
 local label="$2"
 local probe

 mkdir -p "$path" 2>/dev/null || true

 if path_is_read_only "$path"; then
  log_msg "ERROR: ${label} is mounted read-only: $path"
  echo "ERROR: ${label} is mounted read-only"
  return 1
 fi

 probe="$path/.pgenerator-update-write-test.$$"
 if ! : > "$probe" 2>/dev/null; then
  log_msg "ERROR: Cannot write to ${label}: $path"
  echo "ERROR: Cannot write to ${label}"
  return 1
 fi
 rm -f "$probe" 2>/dev/null || true
}

wait_for_local_api() {
 local attempts="${1:-30}"
 local n=0
 local response=""
 while [ "$n" -lt "$attempts" ]; do
  response="$(curl -s --connect-timeout 2 --max-time 3 http://127.0.0.1/api/ping 2>/dev/null || true)"
  if printf '%s' "$response" | grep -q '"ok"[[:space:]]*:[[:space:]]*1'; then
   return 0
  fi
  n=$((n + 1))
  sleep 1
 done
 return 1
}

# ── Pi images may boot without a valid RTC-backed clock ──
clock_seems_invalid() {
 local year
 year=$(date -u +%Y 2>/dev/null || echo 0)
 [ "$year" -lt 2024 ]
}

sync_clock() {
 local server
 for server in pool.ntp.org time.google.com; do
  if command -v ntpdate >/dev/null 2>&1 && timeout 3 ntpdate -ub "$server" >/dev/null 2>&1; then
   return 0
  fi
  if command -v sntp >/dev/null 2>&1 && timeout 3 sntp -sS "$server" >/dev/null 2>&1; then
   return 0
  fi
  if command -v ntpd >/dev/null 2>&1 && timeout 3 ntpd -qn -p "$server" >/dev/null 2>&1; then
   return 0
  fi
 done
 return 1
}

ensure_valid_clock() {
 if ! clock_seems_invalid; then
  return 0
 fi
 log_msg "System clock appears invalid; attempting NTP sync..."
 if sync_clock; then
  log_msg "System clock synced: $(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"
  return 0
 fi
 log_msg "Clock sync failed; GitHub TLS validation may not work"
 return 1
}

# ── Fetch latest release info from GitHub ──
get_latest_release() {
 ensure_valid_clock >/dev/null 2>&1 || true
 curl $CURL_OPTS -H "$GITHUB_ACCEPT" -H "$GITHUB_UA" "$GITHUB_API" 2>/dev/null || true
}

# ── JSON-escape a scalar for Web UI / API responses ──
json_escape() {
 printf '%s' "$1" | perl -MJSON::PP -e 'local $/; my $s=<>; print JSON::PP->new->allow_nonref->encode($s);'
}

# ── Extract a field from the GitHub release JSON ──
# asset_url picks the payload for THIS device: PG_OTA_TARGET (set by the
# caller from device_target()) filters asset names via the same rule as
# asset_matches_target(). Without a target, behaviour is the legacy
# first-tarball pick (kept for the standalone "version" use of this
# script and for old releases that shipped one unsuffixed asset).
release_field() {
 local key="$1"
 printf '%s' "$release_json" | perl -MJSON::PP -e '
  use JSON::PP qw(decode_json);
  # Release notes carry UTF-8 (names, arrows); decode_json gives wide
  # chars that warn on print without an output layer.
  binmode(STDOUT, ":encoding(UTF-8)");
  my $key = shift;
  local $/;
  my $json = <STDIN>;
  my $rel = eval { decode_json($json) };
  exit 1 if(!$rel || ref($rel) ne "HASH");
  my $value = "";
  if($key eq "asset_url") {
   my $target = $ENV{PG_OTA_TARGET} // "";
   if(ref($rel->{assets}) eq "ARRAY") {
    for my $asset (@{$rel->{assets}}) {
     next if(ref($asset) ne "HASH");
     my $url = $asset->{browser_download_url} // "";
     my $name = $asset->{name} // "";
     next if($url !~ /\.tar\.gz$/i);
     if($target ne "") {
      my $is_pi5 = ($name =~ /(?:^|-)pi5/) ? 1 : 0;
      # A payload tagged for another board is never a candidate, even
      # when it is the only tarball the release carries.
      next if($target eq "pi5-bookworm-armhf" ? !$is_pi5 : $is_pi5);
     }
     # Preferred: the named payload. Fallback: first surviving tarball
     # (keeps old single-asset releases with a different name working).
     if($name =~ /pgenerator[-_]?plus.*\.tar\.gz/i) {
      $value = $url;
      last;
     }
     $value = $url if($value eq "");
    }
   }
  } elsif($key eq "body") {
   $value = $rel->{body} // "";
   $value =~ s/\r\n/\n/g;
   $value =~ s/\r/\n/g;
   # 2000 chars: the visible changelog excerpt, and the window the OTA
   # family directive must appear in (see ota_gate_reason).
   $value = substr($value,0,2000);
  } else {
   $value = $rel->{$key} // "";
  }
  print $value;
 ' "$key"
}

# ── Compare semver: returns 0 if $1 > $2 ──
normalize_version() {
 local version="${1:-0}"
 version="${version#v}"
 [ -n "$version" ] || version="0"
 printf '%s' "$version"
}

# Return the MAJOR.MINOR prefix (first two dotted segments) of a version
# string. OTA updates are gated on this: a device on 2.7.x can only OTA to
# another 2.7.x release; 2.8.x stays within 2.8.x. Crossing a MAJOR.MINOR
# boundary requires re-flashing the image (e.g. a new kernel driver).
major_version() {
 local v major minor
 v=$(normalize_version "${1:-0}")
 major=$(printf '%s' "$v" | cut -d. -f1)
 minor=$(printf '%s' "$v" | cut -d. -f2)
 [ -n "$major" ] || major="0"
 [ -n "$minor" ] || minor="0"
 printf '%s.%s' "$major" "$minor"
}

# True if current and target share the same MAJOR.MINOR OTA family.
same_ota_family() {
 [ "$(major_version "${1:-0}")" = "$(major_version "${2:-0}")" ]
}

# Major / minor component of a version as a bare integer (0 if absent).
major_component() {
 local v
 v=$(normalize_version "${1:-0}" | cut -d. -f1 | sed 's/[^0-9].*//')
 printf '%s' "${v:-0}"
}
minor_component() {
 local v
 v=$(normalize_version "${1:-0}" | cut -s -d. -f2 | sed 's/[^0-9].*//')
 printf '%s' "${v:-0}"
}

# OTA gate for a candidate release. Prints nothing and returns 0 when the
# update may proceed, or prints a one-line refusal reason and returns 1.
#   same MAJOR.MINOR          -> allowed (interim updates).
#   next MINOR, same major    -> allowed only when the notes carry a line
#     reading exactly "OTA-Family: cross" (case-insensitive). The marker
#     vouches only for the step from the previous minor, so a device two
#     minors behind could lack an image-only minor's kernel or driver
#     (2.8.1's vc4 HDMI driver is why this gate exists).
#   skipped MINOR, or MAJOR   -> never; re-flash.
ota_gate_reason() {
 local current="$1" latest="$2" body="$3"
 same_ota_family "$current" "$latest" && return 0
 if [ "$(major_component "$current")" != "$(major_component "$latest")" ]; then
  printf 'Release %s crosses the major version boundary from %s. Major releases are image-only: download the full image and re-flash your SD card.' "$latest" "$current"
  return 1
 fi
 if [ "$(minor_component "$latest")" -eq $(( $(minor_component "$current") + 1 )) ] &&
    printf '%s\n' "$body" | grep -qiE '^[[:space:]]*OTA-Family:[[:space:]]*cross[[:space:]]*$'; then
  return 0
 fi
 printf 'A newer image release (%s) is available, but it is outside the OTA family of your current version (%s). OTA updates apply within the same major.minor series, or to the next minor version only when that release is published as overlay-safe. To move to %s, download the full image and re-flash your SD card.' "$latest" "$current" "$latest"
 return 1
}

is_prerelease_version() {
 local version
 version=$(normalize_version "$1")
 case "$version" in
  *[!0-9.]* ) return 0 ;;
 esac
 return 1
}

# ── Device build target ──
# One OTA payload per target; the payload for the wrong board must never
# be extracted. An operator may pin the target with the ota_target key in
# PGenerator.conf (hand-edited; the generic WebUI config writer refuses
# it); otherwise the Pi model string decides. Values match asset naming:
#   pi4-biasi           -> unsuffixed tarball (legacy)
#   pi5-bookworm-armhf  -> tarball tagged "-pi5"
device_target() {
 local t model
 t=$(read_conf_val ota_target)
 # Values outside the known set are treated as unset: a typo in the conf
 # must not turn asset selection into an unknown-target refusal.
 case "$t" in
  pi4-biasi|pi5-bookworm-armhf ) printf '%s' "$t"; return 0 ;;
 esac
 model=""
 [ -r /proc/device-tree/model ] && model=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || true)
 model_target "$model"
}

# Map a /proc/device-tree/model string to a build target. BCM2712 boards
# (Pi 5, Pi 500, CM5) take the Pi 5 payload; BCM2711 boards (Pi 4, Pi 400,
# CM4) take the Pi 4 one -- same split as conf.pm and pg_is_pi4_family.
model_target() {
 case "$1" in
  *"Raspberry Pi 5"*|*"Raspberry Pi Compute Module 5"*|*BCM2712* ) printf 'pi5-bookworm-armhf' ;;
  * ) printf 'pi4-biasi' ;;
 esac
}

# True when an asset name belongs to this device's target. Unknown target
# tags on other assets do NOT disqualify them for a pi4 device: pi4 ships
# unsuffixed and a bare match list keeps old single-asset releases working.
asset_matches_target() {
 local name="$1" target="$2"
 case "$target" in
  pi5-bookworm-armhf ) [[ "$name" == *-pi5* ]] ;;
  pi4-biasi          ) [[ "$name" != *-pi5* ]] ;;
  * ) return 2 ;; # unknown target: caller must refuse to pick blindly
 esac
}

version_gt() {
 local a b
 a=$(normalize_version "$1")
 b=$(normalize_version "$2")
 [ "$a" != "$b" ] && [ "$(printf '%s\n%s' "$a" "$b" | sort -V | tail -1)" = "$a" ]
}

version_le() {
 local a b
 a=$(normalize_version "$1")
 b=$(normalize_version "$2")
 [ "$a" = "$b" ] || [ "$(printf '%s\n%s' "$a" "$b" | sort -V | tail -1)" = "$b" ]
}

migration_script_version() {
 local base
 base="$(basename "$1")"
 printf '%s' "$base" | sed -E 's/^v?([0-9]+(\.[0-9]+)*).*/\1/'
}

# OTA tarballs ship factory defaults as PGenerator.conf.dist and never
# overwrite the device's live /etc/PGenerator/PGenerator.conf (it holds
# operator state: signal mode, HDR metadata, DV transport, ...). After
# extraction, append any NEW default keys the release introduced so code
# that expects them always finds a value, while existing values are kept.
merge_conf_defaults() {
 local dist="/etc/PGenerator/PGenerator.conf.dist"
 local conf="/etc/PGenerator/PGenerator.conf"
 local line key added
 [ -f "$dist" ] || return 0
 if [ ! -f "$conf" ]; then
  cp -a "$dist" "$conf"
  log_msg "conf: installed factory defaults (no existing PGenerator.conf)"
  return 0
 fi
 added=0
 while IFS= read -r line; do
  case "$line" in ''|'#'*) continue ;; esac
  key="${line%%=*}"
  [ -n "$key" ] || continue
  case "$key" in *[!A-Za-z0-9_]* ) continue ;; esac
  if ! grep -q "^${key}=" "$conf"; then
   printf '%s\n' "$line" >> "$conf"
   added=$((added + 1))
   log_msg "conf: added new default key ${key}"
  fi
 done < "$dist"
 [ "$added" -gt 0 ] && sync || true
}

# ── Restore executable bits after extraction ──
# tar restores whatever modes the archive carries, so a payload built from a
# checkout with core.filemode=false arrives with its scripts non-executable —
# 2.11.6 and 2.11.7 landed /etc/init.d/rcPGenerator as 0664, which stops the
# daemon from starting at boot and makes this script's own restart fail.
# Every release from 2.11.8 records the program files it ships in
# release-exec-manifest.txt; reapply them before anything is run.
restore_exec_bits() {
 local manifest="$1"
 local restored=0
 local path rel

 [[ -f "$manifest" ]] || return 0

 while IFS= read -r rel; do
  [[ -n "$rel" ]] || continue
  case "$rel" in
   \#*|/*|*..*) continue ;;
  esac
  path="/$rel"
  [[ -f "$path" ]] || continue
  [[ -x "$path" ]] && continue
  chmod 0755 "$path" 2>/dev/null || true
  restored=$((restored + 1))
 done < "$manifest"

 if [[ "$restored" -gt 0 ]]; then
  log_msg "Restored executable bits on $restored extracted program files"
 fi
}

run_update_migrations() {
 local from_version target_version migration_count path script_version base
 from_version=$(normalize_version "${1:-0}")
 target_version=$(normalize_version "${2:-0}")
 migration_count=0

 [ -d "$UPDATE_MIGRATIONS_DIR" ] || return 0

 while IFS= read -r path; do
  [ -n "$path" ] || continue
  base="$(basename "$path")"
  script_version=$(migration_script_version "$base")
  if [ -z "$script_version" ] || [ "$script_version" = "$base" ]; then
   log_msg "Skipping OTA migration with unparseable version: $base"
   continue
  fi
  if version_gt "$script_version" "$from_version" && version_le "$script_version" "$target_version"; then
   migration_count=$((migration_count + 1))
   log_msg "Running OTA migration $base"
   chmod +x "$path" 2>/dev/null || true
   if ! PG_UPDATE_FROM="$from_version" PG_UPDATE_TO="$target_version" PG_MIGRATION_VERSION="$script_version" "$path" >> "$UPDATE_LOG" 2>&1; then
    log_msg "ERROR: OTA migration failed: $base"
    echo "ERROR: OTA migration failed: $base"
    return 1
   fi
  fi
 done < <(find "$UPDATE_MIGRATIONS_DIR" -maxdepth 1 -type f -name '*.sh' | sort -V)

 if [ "$migration_count" -eq 0 ]; then
  log_msg "No OTA migrations needed for $from_version -> $target_version"
 fi
}

cmd="${1:-help}"

case "$cmd" in

 version)
  echo "$(get_current_version)"
  ;;

 check)
  current=$(get_current_version)
  export PG_OTA_TARGET="$(device_target)"
  release_json=$(get_latest_release)
  if [ -z "$release_json" ]; then
   printf '{"status":"error","message":%s}\n' "$(json_escape "Cannot reach GitHub")"
   exit 1
  fi

  latest=$(release_field tag_name 2>/dev/null | sed 's/^v//')
  message=$(release_field message 2>/dev/null || true)
  published=$(release_field published_at 2>/dev/null || true)
  changelog=$(release_field body 2>/dev/null || true)
  asset_url=$(release_field asset_url 2>/dev/null || true)

    if is_prerelease_version "$current"; then
     printf '{"status":"ok","current":%s,"latest":%s,"update_available":false,"published":%s,"changelog":%s,"asset_url":""}\n' \
      "$(json_escape "$current")" \
      "$(json_escape "$current")" \
      "$(json_escape "")" \
      "$(json_escape "OTA updates are disabled on beta builds. Flash a matching stable or newer beta image instead.")"
     exit 0
    fi

  if [ -z "$latest" ] && [ "$message" = "Not Found" ]; then
   printf '{"status":"ok","current":%s,"latest":%s,"update_available":false,"published":"","changelog":%s,"asset_url":""}\n' \
    "$(json_escape "$current")" \
    "$(json_escape "$current")" \
    "$(json_escape "No releases published yet.")"
   exit 0
  fi

  if [ -z "$latest" ]; then
   [ -z "$message" ] && message="Cannot parse release info"
   printf '{"status":"error","message":%s}\n' "$(json_escape "$message")"
   exit 1
  fi

  if version_gt "$latest" "$current"; then
   update_available=true
  else
   update_available=false
  fi

  # OTA family gate (see ota_gate_reason); apply re-runs the same check.
  gate_reason=""
  if ! gate_reason=$(ota_gate_reason "$current" "$latest" "$changelog"); then
   update_available=false
   changelog="$gate_reason"
   asset_url=""
  fi

  trusted=false
  custom_repo_trusted "$GITHUB_REPO" && trusted=true
  printf '{"status":"ok","current":%s,"latest":%s,"update_available":%s,"published":%s,"changelog":%s,"asset_url":%s,"repo":%s,"trusted":%s}\n' \
   "$(json_escape "$current")" \
   "$(json_escape "$latest")" \
   "$update_available" \
   "$(json_escape "$published")" \
   "$(json_escape "$changelog")" \
   "$(json_escape "$asset_url")" \
   "$(json_escape "$GITHUB_REPO")" \
   "$trusted"
  ;;

 apply)
  current=$(get_current_version)
  export PG_OTA_TARGET="$(device_target)"
  log_msg "Update check started (current: $current)"

  # Custom-repo root-trust gate (PR-20 review finding #1): apply extracts
  # an unsigned tarball at / as root, so only repos in the factory allow-
  # list (default + upstream BigShoots) or a repo carrying the operator's
  # ota_repo_trusted=1 key may install. A cross-site request can at most
  # rewrite ota_repo; without the trust key the download never starts.
  if ! custom_repo_trusted "$GITHUB_REPO"; then
   log_msg "ERROR: refusing to apply from untrusted repo $GITHUB_REPO"
   echo "ERROR: Update source $GITHUB_REPO is not trusted. Set it from the WebUI Software Update card and confirm the trust prompt." >&2
   printf '{"status":"error","message":"Update source %s is not trusted. Save it from the WebUI and confirm the trust prompt.","repo":"%s"}\n' "$GITHUB_REPO" "$GITHUB_REPO"
   exit 1
  fi

  release_json=$(get_latest_release)
  if [ -z "$release_json" ]; then
   log_msg "ERROR: Cannot reach GitHub"
   echo "ERROR: Cannot reach GitHub"
   exit 1
  fi

  latest=$(release_field tag_name 2>/dev/null | sed 's/^v//')
  asset_url=$(release_field asset_url 2>/dev/null || true)
  message=$(release_field message 2>/dev/null || true)
  body=$(release_field body 2>/dev/null || true)

    if is_prerelease_version "$current"; then
     log_msg "ERROR: OTA updates are disabled on beta builds ($current)"
     echo "ERROR: OTA updates are disabled on beta builds ($current)"
     exit 1
    fi

  if [ -z "$latest" ]; then
   [ -z "$message" ] && message="Cannot parse release info"
   log_msg "ERROR: $message"
   echo "ERROR: $message"
   exit 1
  fi

  if ! version_gt "$latest" "$current"; then
   log_msg "Already up to date ($current)"
   echo "Already up to date ($current)"
   exit 0
  fi

  # OTA family gate: the same check the check-branch used (ota_gate_reason).
  gate_reason=""
  if ! gate_reason=$(ota_gate_reason "$current" "$latest" "$body"); then
   log_msg "ERROR: $gate_reason"
   echo "ERROR: $gate_reason"
   exit 1
  fi

  if [ -z "$asset_url" ]; then
   log_msg "ERROR: No OTA payload for target $PG_OTA_TARGET in release $latest"
   echo "ERROR: Release $latest has no update payload for this device (target $PG_OTA_TARGET)."
   echo "Check the release assets or re-flash the image for this board."
   exit 1
  fi

    require_writable_path "$UPDATE_DIR" "update directory"
    require_writable_path "/usr/share/PGenerator" "PGenerator install tree"

  log_msg "Downloading $latest from $asset_url"
  # Second target check at the download site: even if asset selection or
  # config changed between check and apply, a payload tagged for another
  # board never gets extracted.
  asset_name="${asset_url##*/}"
  if ! asset_matches_target "$asset_name" "$PG_OTA_TARGET"; then
   log_msg "ERROR: refusing to extract payload for wrong target: $asset_name (device: $PG_OTA_TARGET)"
   echo "ERROR: Selected payload $asset_name does not match this device (target $PG_OTA_TARGET)."
   exit 1
  fi
  mkdir -p "$UPDATE_DIR"
  tarball="$UPDATE_DIR/pgenerator-plus-${latest}.tar.gz"
  if ! curl -f $CURL_OPTS -H "$GITHUB_UA" -o "$tarball" "$asset_url" 2>/dev/null; then
   log_msg "ERROR: Download failed"
   echo "ERROR: Download failed"
   exit 1
  fi

  if [ ! -s "$tarball" ]; then
   log_msg "ERROR: Download failed or empty file"
   echo "ERROR: Download failed"
   exit 1
  fi

  if ! tar tzf "$tarball" >/dev/null 2>&1; then
   log_msg "ERROR: Downloaded asset is not a valid tar.gz archive"
   echo "ERROR: Invalid update archive"
   rm -f "$tarball"
   exit 1
  fi

  log_msg "Stopping PGenerator..."
  /etc/init.d/PGenerator stop 2>/dev/null || true
  sleep 2

  require_writable_path "/" "root filesystem"

  log_msg "Extracting update..."
  cd /
  tar xzf "$tarball" 2>&1 | tee -a "$UPDATE_LOG"

  restore_exec_bits "$EXEC_MANIFEST_FILE"

  # A payload built with a widened umask packages these group-writable, and
  # extraction applies that to the live tree. OpenSSH then refuses to start
  # because /var is group-writable, taking SSH down with it.
  chmod 0755 / /etc /lib /usr /var 2>/dev/null || true

  chmod +x /usr/sbin/pgenerator-* 2>/dev/null || true
  chmod +x /usr/sbin/PGeneratord* 2>/dev/null || true
  chmod +x /etc/init.d/PGenerator /etc/init.d/rcPGenerator /etc/init.d/dhcp 2>/dev/null || true
  chmod +x /usr/bin/PGenerator_*.pl 2>/dev/null || true
  chmod +x /usr/bin/pgenerator-* 2>/dev/null || true
  chmod +x /usr/bin/spotread /usr/bin/chartread /usr/bin/colprof /usr/bin/profcheck /usr/bin/targen /usr/bin/applycal /usr/bin/pgsethdr 2>/dev/null || true
  chmod +x /usr/bin/spotread_wrapper.sh 2>/dev/null || true
  chmod +x /usr/bin/meter_*.sh 2>/dev/null || true
  chmod +x /usr/bin/spotread_measure.py 2>/dev/null || true
  chown root:root /etc/sudo/sudoers /etc/sudo/sudoers.d /etc/sudo/sudoers.d/PGenerator /etc/sudoers.d /etc/sudoers.d/PGenerator 2>/dev/null || true
  chmod 755 /etc/sudo /etc/sudo/sudoers.d /etc/sudoers.d 2>/dev/null || true
  chmod 440 /etc/sudo/sudoers /etc/sudo/sudoers.d/PGenerator /etc/sudoers.d/PGenerator 2>/dev/null || true

  merge_conf_defaults

  run_update_migrations "$current" "$latest"

  require_writable_path "/usr/share/PGenerator" "PGenerator install tree"

  rm -f "$tarball"
  sync

  log_msg "Update to $latest extracted — restarting PGenerator..."
  if ! /etc/init.d/PGenerator start 2>/dev/null; then
   log_msg "ERROR: PGenerator restart command failed after update"
   echo "ERROR: PGenerator restart failed after update"
   exit 1
  fi

  if ! wait_for_local_api 30; then
   log_msg "ERROR: PGenerator API did not recover after updating to $latest"
   echo "ERROR: PGenerator did not come back after update"
   exit 1
  fi

  echo "OK: Updated to $latest"
  ;;

 *)
  echo "Usage: pgenerator-update {check|apply|version}"
  echo ""
  echo "  check    — Check for available updates"
  echo "  apply    — Download and install latest update"
  echo "  version  — Show current version"
  exit 1
  ;;
esac
