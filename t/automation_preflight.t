{
 no warnings 'redefine';
 local *main::webui_lg_status_json=sub { return PGAutomation::encode_json({paired=>1,connected=>$connected,disconnected=>!$connected,software_version=>'test',calibration_mode=>$calibration_on}); };
 local *main::webui_lg_calibration_mode=sub {
  $exit_calls++;
