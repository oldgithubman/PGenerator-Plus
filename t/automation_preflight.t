  like(main::webui_automation_preflight_status()->{message},qr/calibration mode/,'calibration exit progress is persisted before the TV request');
  return PGAutomation::encode_json($exit_ok?{status=>'ok',calibration_mode=>0}:{status=>'error',message=>'CAL_END rejected'});
 };
 local *main::webui_meter_status=sub { return PGAutomation::encode_json({detected=>1}); };
 local *main::webui_meter_series_alive=sub {0};
