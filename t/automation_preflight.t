File::Path::make_path(PGAutomation::run_dir('last-failed'));
PGAutomation::write_json_atomic(PGAutomation::run_dir('last-failed').'/run.json',{id=>'last-failed',status=>'failed',items=>[],failure=>{stage=>'meter-read',message=>'USB disconnected'}});
