{
 no warnings 'redefine';
 my $connects=0;my $connected=0;my $paired=1;my $available=1;
 local *main::webui_automation_read_execution=sub {{run_id=>'resume-test',token=>'saved-token'}};
 local *main::webui_lg_status_json=sub {PGAutomation::encode_json({connected=>$connected,disconnected=>!$connected,paired=>$paired})};
 local *main::webui_lg_connect=sub {$connects++;PGAutomation::encode_json({status=>$available?'ok':'error',connected=>$available,message=>'TV offline'})};
 my $run={id=>'resume-test',token=>'saved-token'};
 is(main::webui_automation_reconnect_for_resume($run)->{status},'ok','Resume reconnects the paired TV after a service restart');
